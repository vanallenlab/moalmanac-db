{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moalmanac.org/schemas/referenced/therapies.schema.json",
  "title": "Therapy",
  "description": "A therapeutic agent concept.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tx:ncit:C\\d+$"
    },
    "conceptType": {
      "const": "Therapy"
    },
    "name": {
      "type": "string"
    },
    "primary_coding_id": {
      "type": "string",
      "pattern": "^coding:[a-z]+:.+$",
      "description": "Foreign key to `codings.id`."
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^map:.+::.+$",
        "description": "Foreign key to `mappings.id`."
      }
    },
    "therapy_strategy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "therapy_type": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "conceptType",
    "name",
    "primary_coding_id",
    "mappings",
    "therapy_strategy",
    "therapy_type"
  ],
  "additionalProperties": false
}
