{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moalmanac.org/schemas/referenced/agents.schema.json",
  "title": "Agent",
  "description": "An organization or person that publishes documents or contributes to records.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^agent:(org|user):[a-z0-9]+$"
    },
    "type": {
      "const": "Agent"
    },
    "agentType": {
      "enum": [
        "organization",
        "contributor"
      ]
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "last_updated": {
      "type": "string"
    },
    "url": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "agentType",
    "name",
    "description"
  ],
  "additionalProperties": false
}
