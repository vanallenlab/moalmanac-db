{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moalmanac.org/schemas/referenced/agents.schema.json",
  "title": "Agent",
  "description": "An organization or person that publishes documents or contributes to records. Subtypes are selected by the `agentType` field.",
  "$ref": "#/$defs/Agent",
  "allOf": [
    {
      "if": {
        "required": [
          "agentType"
        ],
        "properties": {
          "agentType": {
            "const": "organization"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/Organization"
      }
    },
    {
      "if": {
        "required": [
          "agentType"
        ],
        "properties": {
          "agentType": {
            "const": "person"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/Person"
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "Agent": {
      "description": "Root type shared by every agent. Subtypes below are selected by the `agentType` field; the top-level schema closes the record.",
      "type": "object",
      "required": [
        "id",
        "type",
        "agentType",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^agent:(org|user):[a-z0-9]+$"
        },
        "type": {
          "const": "Agent"
        },
        "agentType": {
          "enum": [
            "organization",
            "person"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "affiliation": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^agent:org:[a-z0-9]+$",
            "description": "Foreign key to `agents.id` of an organization this agent belongs to."
          }
        },
        "url": {
          "type": "string"
        }
      }
    },
    "Organization": {
      "description": "A regulatory agency, research group, or institution.",
      "required": [
        "organizationType"
      ],
      "properties": {
        "id": {
          "pattern": "^agent:org:[a-z0-9]+$"
        },
        "organizationType": {
          "enum": [
            "institution",
            "regulatory agency",
            "research group"
          ]
        },
        "last_updated": {
          "type": "string"
        }
      }
    },
    "Person": {
      "description": "An individual who contributes to records.",
      "properties": {
        "id": {
          "pattern": "^agent:user:[a-z0-9]+$"
        }
      }
    }
  }
}
