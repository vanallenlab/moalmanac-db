{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moalmanac.org/schemas/referenced/propositions.schema.json",
  "title": "Proposition",
  "description": "A VA-Spec proposition about one or more biomarkers. Root type `Proposition` with one subtype per `type` value.",
  "$ref": "#/$defs/Proposition",
  "allOf": [
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "VariantTherapeuticResponseProposition"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/VariantTherapeuticResponseProposition"
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "VariantPrognosticProposition"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/VariantPrognosticProposition"
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "Proposition": {
      "description": "Root type shared by every proposition. Subtypes below are selected by the `type` field; the top-level schema closes the record.",
      "type": "object",
      "required": [
        "id",
        "type",
        "predicate",
        "biomarker_criteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^prop:(vtxr|vprog):\\d+$"
        },
        "type": {
          "enum": [
            "VariantTherapeuticResponseProposition",
            "VariantPrognosticProposition"
          ]
        },
        "predicate": {
          "type": "string"
        },
        "biomarker_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^bmkr\\.criterion:\\d+$",
            "description": "Foreign key to `biomarker_criteria.id`."
          },
          "minItems": 1
        }
      }
    },
    "VariantTherapeuticResponseProposition": {
      "description": "Biomarker(s) predict a therapeutic response in a disease. Exactly one of `therapy_id` or `therapy_group_id` is set.",
      "allOf": [
        {
          "$ref": "#/$defs/Proposition"
        },
        {
          "required": [
            "conditionQualifier_id",
            "therapy_id",
            "therapy_group_id"
          ],
          "properties": {
            "id": {
              "pattern": "^prop:vtxr:\\d+$"
            },
            "predicate": {
              "enum": [
                "predictsSensitivityTo",
                "predictsResistanceTo"
              ]
            },
            "conditionQualifier_id": {
              "type": "string",
              "pattern": "^dis:(oncotree|ncit):.+$",
              "description": "Foreign key to `diseases.id`."
            },
            "therapy_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^tx:ncit:C\\d+$",
              "description": "Foreign key to `therapies.id`."
            },
            "therapy_group_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^txgrp:\\d+$",
              "description": "Foreign key to `therapy_groups.id`."
            }
          },
          "oneOf": [
            {
              "properties": {
                "therapy_id": {
                  "type": "string"
                },
                "therapy_group_id": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "therapy_id": {
                  "type": "null"
                },
                "therapy_group_id": {
                  "type": "string"
                }
              }
            }
          ]
        }
      ]
    },
    "VariantPrognosticProposition": {
      "description": "Biomarker(s) are associated with a better or worse outcome for a disease. It has no therapy or condition qualifier fields.",
      "allOf": [
        {
          "$ref": "#/$defs/Proposition"
        },
        {
          "required": [
            "objectCondition_id"
          ],
          "properties": {
            "id": {
              "pattern": "^prop:vprog:\\d+$"
            },
            "predicate": {
              "enum": [
                "associatedWithBetterOutcomeFor",
                "associatedWithWorseOutcomeFor"
              ]
            },
            "objectCondition_id": {
              "type": "string",
              "pattern": "^dis:(oncotree|ncit):.+$",
              "description": "Foreign key to `diseases.id`."
            }
          }
        }
      ]
    }
  }
}
