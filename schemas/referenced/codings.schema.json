{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moalmanac.org/schemas/referenced/codings.schema.json",
  "title": "Coding",
  "description": "A code within a coding system, e.g. `oncotree:BRCA` or `ncit:C97660`.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^coding:[a-z]+:.+$"
    },
    "code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "system": {
      "type": "string"
    },
    "systemVersion": {
      "type": "string"
    },
    "iris": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  },
  "required": [
    "id",
    "code",
    "system",
    "iris"
  ],
  "additionalProperties": false
}
