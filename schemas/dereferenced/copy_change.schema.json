{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moalmanac.org/schemas/dereferenced/copy_change.schema.json",
  "title": "CopyChange",
  "description": "A copy change term, e.g. gain or loss.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^copy_change:efo:\\d+$"
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "additionalProperties": false
}
