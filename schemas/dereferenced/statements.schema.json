{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moalmanac.org/schemas/dereferenced/statements.schema.json",
  "title": "Statement",
  "description": "A knowledge claim, with contributions, documents, proposition, and strength embedded. `status` is an extension, as is the underlying `indication` of a regulatory statement. Journal statements have no `indication` extension.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^stmt:(fda|ema|hse|hc|hpra|pmid):.+$"
    },
    "type": {
      "const": "Statement"
    },
    "description": {
      "type": "string"
    },
    "contributions": {
      "type": "array",
      "items": {
        "$ref": "contributions.schema.json"
      }
    },
    "reportedIn": {
      "type": "array",
      "items": {
        "$ref": "documents.schema.json"
      }
    },
    "direction": {
      "enum": [
        "supports",
        "disputes",
        "neutral"
      ]
    },
    "proposition": {
      "$ref": "propositions.schema.json"
    },
    "strength": {
      "$ref": "strengths.schema.json"
    },
    "extensions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "extension.schema.json",
            "properties": {
              "name": {
                "const": "status"
              },
              "value": {
                "enum": [
                  "Active",
                  "Superseded",
                  "Deprecated"
                ]
              }
            }
          },
          {
            "$ref": "extension.schema.json",
            "properties": {
              "name": {
                "const": "indication"
              },
              "value": {
                "$ref": "indications.schema.json",
                "properties": {
                  "extensions": {
                    "not": {
                      "contains": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "const": "statement description"
                          }
                        },
                        "required": [
                          "name"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "$ref": "extension.schema.json",
            "properties": {
              "name": {
                "const": "status"
              },
              "value": {
                "enum": [
                  "Active",
                  "Superseded",
                  "Deprecated"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "id",
    "type",
    "description",
    "contributions",
    "reportedIn",
    "direction",
    "proposition",
    "strength",
    "extensions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "pattern": "^stmt:pmid:"
          }
        }
      },
      "then": {
        "properties": {
          "extensions": {
            "items": {
              "properties": {
                "name": {
                  "enum": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "extensions": {
            "allOf": [
              {
                "contains": {
                  "$ref": "extension.schema.json",
                  "properties": {
                    "name": {
                      "const": "indication"
                    },
                    "value": {
                      "$ref": "indications.schema.json",
                      "properties": {
                        "extensions": {
                          "not": {
                            "contains": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "const": "statement description"
                                }
                              },
                              "required": [
                                "name"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
