{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moalmanac.org/schemas/dereferenced/propositions.schema.json",
  "title": "Proposition",
  "description": "A VA-Spec proposition, selected by `type`. Because Cat-VRS does not yet support sets of categorical variants, `subjectVariant` is a placeholder and the biomarker criteria are held in the `biomarkers` extension.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^prop:(vtxr|vprog):\\d+$"
    },
    "type": {
      "enum": [
        "VariantTherapeuticResponseProposition",
        "VariantPrognosticProposition"
      ]
    },
    "predicate": {
      "type": "string"
    },
    "subjectVariant": {
      "type": "object",
      "properties": {
        "type": {
          "const": "CategoricalVariant"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "description"
      ],
      "additionalProperties": false
    },
    "conditionQualifier": {
      "$ref": "diseases.schema.json"
    },
    "objectTherapeutic": {
      "oneOf": [
        {
          "$ref": "therapies.schema.json"
        },
        {
          "$ref": "therapy_groups.schema.json"
        }
      ]
    },
    "extensions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "extension.schema.json",
            "properties": {
              "name": {
                "const": "biomarkers"
              },
              "value": {
                "type": "array",
                "items": {
                  "$ref": "biomarker_criteria.schema.json"
                },
                "minItems": 1
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "$ref": "extension.schema.json",
            "properties": {
              "name": {
                "const": "biomarkers"
              },
              "value": {
                "type": "array",
                "items": {
                  "$ref": "biomarker_criteria.schema.json"
                },
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "objectCondition": {
      "$ref": "diseases.schema.json"
    }
  },
  "required": [
    "id",
    "type",
    "predicate",
    "subjectVariant",
    "extensions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "VariantTherapeuticResponseProposition"
          }
        }
      },
      "then": {
        "required": [
          "conditionQualifier",
          "objectTherapeutic"
        ],
        "not": {
          "required": [
            "objectCondition"
          ]
        },
        "properties": {
          "id": {
            "pattern": "^prop:vtxr:\\d+$"
          },
          "predicate": {
            "enum": [
              "predictsSensitivityTo",
              "predictsResistanceTo"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "VariantPrognosticProposition"
          }
        }
      },
      "then": {
        "required": [
          "objectCondition"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "conditionQualifier"
              ]
            },
            {
              "required": [
                "objectTherapeutic"
              ]
            }
          ]
        },
        "properties": {
          "id": {
            "pattern": "^prop:vprog:\\d+$"
          },
          "predicate": {
            "enum": [
              "associatedWithBetterOutcomeFor",
              "associatedWithWorseOutcomeFor"
            ]
          }
        }
      }
    }
  ]
}
